      "includes": "tasks/*/gold.py"
    },
    {
      "@type": "cr:FileSet",
      "@id": "task-fixtures",
      "name": "task_fixtures",
      "description": "Optional task fixtures, including the third-party STEP fixture for the M3 socket-head screw task.",
